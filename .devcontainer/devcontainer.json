{
    "name": "GAN Development Environment",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "gan_dev_env",
    "workspaceFolder": "/tf/TCC_GAN",
    "shutdownAction": "stopCompose",
    "remoteUser": "root",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python", // Extensão Python da Microsoft (essencial para Python no VS Code)
                "ms-toolsai.jupyter", // Extensão Jupyter da Microsoft (para notebooks .ipynb no VS Code)
                "ms-python.black-formatter", // Extensão Black Formatter para formatação de código Python
                "GitHub.copilot",
                "GitHub.copilot-chat"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/bin/python", // Caminho do interpretador Python dentro do container
                "jupyter.jupyterServerType": "local", // Configuração para usar o servidor Jupyter local
                "jupyter.enableNotebookAutoSave": true, // Habilita o salvamento automático de notebooks
                "jupyter.sendSelectionToInteractiveWindow": true, // Habilita o envio de seleção para a janela interativa
                "jupyter.interactiveWindowMode": "perFile", // Modo de janela interativa por arquivo
                "jupyter.interactiveWindowShowCode": true, // Exibe o código na janela interativa
                "jupyter.interactiveWindowShowVariableExplorer": true, // Exibe o explorador de variáveis na janela interativa
                "jupyter.interactiveWindowShowDataExplorer": true, // Exibe o explorador de dados na janela interativa
                "editor.formatOnSave": true, // Ativa a formatação sempre que o ficheiro for salvo
                "[python]": {
                    "editor.defaultFormatter": "ms-python.black-formatter"
                }, // 2. Define o 'black' como o formatador padrão para ficheiros Python
                "python.linting.enabled": true, // Habilita a verificação de erros e estilo de código Python
                "python.linting.flake8Enabled": true, // Habilita o Flake8 como verificador de estilo de código
                "python.linting.lintOnSave": true // Verifica erros e estilo de código ao salvar
            }
        }
    }
}