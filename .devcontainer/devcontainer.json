{
    "name": "TCC GAN Development",
    "dockerComposeFile": "../docker-compose.yml", // Path to your docker-compose.yml
    "service": "jupyter_gan", // Name of the service in docker-compose.yml
    "workspaceFolder": "/tf/TCC_GAN", // Your working directory inside the container
    "shutdownAction": "stopCompose", // Action to take when closing VS Code
    "extensions": [
        "ms-python.python", // Extensão Python
        "ms-toolsai.jupyter" // Extensão Jupyter
    ],
    "remoteUser": "root" // Default user inside the container (usually root for NVIDIA images)
}